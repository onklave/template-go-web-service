# Keep the build context small. Do NOT exclude go.mod/go.sum or source.
.git
.gitignore
.github
README.md
Dockerfile
.dockerignore

# Local build artifacts
/server
*.test
*.out

# Never let local secrets into the build context: the build stage does
# "COPY . .", so anything here is readable in that layer and in the build cache.
.env
.env.*

# Audit/metadata, not needed to build.
.onklave
